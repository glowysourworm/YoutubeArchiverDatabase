<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.org/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Database Connection -->
        <property name="hibernate.connection.driver_class">org.mariadb.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:3306/YoutubeArchiver</property>

        <!-- Schema & Logging Settings -->
        <property name="hibernate.show_sql">true</property>

        <!-- Register Mapped Entities -->
        <mapping class="YoutubeArchiverDatabase.Model.YoutubeUserChannelMap" />
    </session-factory>
</hibernate-configuration>